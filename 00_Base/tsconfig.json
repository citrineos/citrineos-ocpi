{
  "extends": "../tsconfig.build.json",
  "include": ["src/**/*.ts", "src/**/*.json"],
  "exclude": [
    "**/dist/**",
    "**/node_modules/**",
    "**/__tests__/**",
    "**/__mocks__/**",
    "**/*.test.ts"
  ],
  "compilerOptions": {
    "outDir": "./dist",
    "composite": true,
    "rootDir": "./src"
  }
}
