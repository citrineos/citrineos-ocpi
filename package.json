{
  "name": "@citrineos/ocpi-workspace",
  "version": "2.0.1",
  "private": false,
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@graphql-codegen/add": "^5.0.3",
    "@graphql-codegen/cli": "^5.0.7",
    "@graphql-codegen/typescript": "^4.1.6",
    "@graphql-codegen/typescript-operations": "^4.6.1",
    "@graphql-eslint/eslint-plugin": "^4.4.0",
    "@testcontainers/postgresql": "^11.14.0",
    "@types/csv-parse": "^1.1.12",
    "@types/eslint__js": "8.42.3",
    "@types/jest": "^30.0.0",
    "@typescript-eslint/eslint-plugin-tslint": "^7.0.2",
    "concurrently": "^8.2.2",
    "cross-env": "^10.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-prettier": "5.2.3",
    "jest": "^30.3.0",
    "nock": "^14.0.17",
    "prettier": "^3.2.5",
    "sequelize-cli": "^6.6.2",
    "testcontainers": "^11.14.0",
    "ts-jest": "^29.4.6",
    "typescript": "5.5.4",
    "typescript-eslint": "^8.7.0",
    "vitest": "^4.1.11"
  },
  "scripts": {
    "test": "jest --config jest.config.cjs",
    "pretest:integration": "node ./Tests/helpers/pull-images.mjs",
    "test:integration": "vitest run --config vitest.config.ts",
    "test:all": "npm run test && npm run test:integration",
    "sync-db": "ts-node ./db.sync.ts",
    "init-db": "npx sequelize-cli db:migrate --debug && echo migration completed successfully",
    "seed-db": "npx sequelize-cli db:seed:all --debug",
    "seed-undo": "npx sequelize-cli db:seed:undo:all --debug",
    "clean-db": "npx sequelize-cli db:seed:undo:all --debug",
    "clean-and-seed-db": "npm run clean-db && npm run seed-db",
    "start-mock-emsp": "npm run build && nodemon ./mock-client/index.ts --config ./mock-client/nodemon.json",
    "start-mockoon": "npm run start-mock-emsp && mockoon-cli start --data http://localhost:8086/docs/spec --port 3000",
    "start": "npm run start --prefix ./Server",
    "start-docker-compose": "npm run start-docker-compose --prefix ./Server",
    "start-docker": "npm run start-docker --prefix ./Server",
    "start-docker-cloud": "npm run start-docker-cloud --prefix ./Server",
    "install-all": "npm i --verbose",
    "clear-cache": "npm cache clean --force",
    "remove-dependencies": "rm -rf package-lock.json **/package-lock.json **/**/package-lock.json node_modules **/node_modules **/**/node_modules",
    "fresh": "npm run clean && npm run remove-dependencies && npm run clear-cache",
    "clean-tsbuildinfo": "find . -name tsconfig.tsbuildinfo -not -path '*/node_modules/*' -exec rm -f {} +",
    "clean-dist": "find . -type d -name dist -not -path '*/node_modules/*' -exec rm -rf {} +",
    "clean": "npm run clean-dist && npm run clean-tsbuildinfo",
    "build": "tsc --build --verbose",
    "postbuild": "npm run copy-assets --prefix ./Server && npm run migrate:build",
    "lint": "npx eslint ./",
    "lint-fix": "npm run prettier && npx eslint --fix ./",
    "prettier": "prettier --write .",
    "fi": "npm run fresh && npm run install-all",
    "generate": "graphql-codegen",
    "migrate:build": "tsc --project migrations/tsconfig.json",
    "migrate": "npm run migrate:build && npx sequelize-cli db:migrate && echo migration completed successfully",
    "gireve-retry": "cross-env APP_ENV=${APP_ENV:-docker} tsx Server/src/gireve-retry/index.ts",
    "gireve-retry:dist": "cross-env APP_ENV=${APP_ENV:-docker} node Server/dist/gireve-retry/index.js"
  },
  "workspaces": [
    "./00_Base",
    "./03_Modules/Commands",
    "./03_Modules/Credentials",
    "./03_Modules/Locations",
    "./03_Modules/Versions",
    "./03_Modules/ChargingProfiles",
    "./03_Modules/Sessions",
    "./03_Modules/Tariffs",
    "./03_Modules/Cdrs",
    "./03_Modules/Tokens",
    "./03_Modules/AdminModule",
    "./03_Modules/Certificates",
    "./03_Modules/DtoRouter",
    "./Server"
  ],
  "dependencies": {
    "@zetra/citrineos-base": "prod",
    "@zetra/citrineos-certificates": "prod",
    "@zetra/citrineos-configuration": "prod",
    "@zetra/citrineos-data": "prod",
    "@zetra/citrineos-evdriver": "prod",
    "@zetra/citrineos-monitoring": "prod",
    "@zetra/citrineos-ocpprouter": "prod",
    "@zetra/citrineos-reporting": "prod",
    "@zetra/citrineos-smartcharging": "prod",
    "@zetra/citrineos-tenant": "prod",
    "@zetra/citrineos-transactions": "prod",
    "@zetra/citrineos-util": "prod",
    "csv-parse": "^6.2.1"
  },
  "overrides": {
    "@zetra/citrineos-base": "$@zetra/citrineos-base"
  }
}
